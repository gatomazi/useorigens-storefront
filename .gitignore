# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated INK snapshot (rebuilt by npm run catalog:sync)
/data/generated/

# playwright
/test-results/
/playwright-report/

# intermediate visual-QA passes (kept locally, documented in docs/design/nightly-visual-pass.md)
/docs/design/screenshots/sul-pass-1/
/docs/design/screenshots/sul-pass-2/
/docs/design/screenshots/banner-placement-fix/
/docs/design/screenshots/hero-cards/
/docs/design/screenshots/home-final-order/
/docs/design/screenshots/lenda-order-viewall/
/docs/design/screenshots/sul-color/

# local CMS sandbox: drafts, sandbox publications, uploads (docs/admin/cms-local-usage.md)
/data/admin-dev/

# INK API (server-only, never NEXT_PUBLIC_*). Copy to .env.local and fill in.
INK_API_BASE_URL=https://api.reserva.ink
INK_TOKEN_SUL=
INK_TOKEN_NORTE=
INK_TOKEN_CENTRO=

# regional (default): each region resolves to its own INK store (Sul->Use Sul, Norte->Use Norte, ...).
# A comma list overrides globally, only when stores are really consolidated: use-origens,use-sul
COMMERCE_STORE_PRIORITY=regional

# Public site URL for canonical/OG metadata.
NEXT_PUBLIC_SITE_URL=https://www.useorigens.com.br

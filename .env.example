# INK API (server-only, never NEXT_PUBLIC_*). Copy to .env.local and fill in.
# Only needed by the SYNC path (`npm run catalog:sync`, POST /api/admin/catalog-sync) — the running web
# app (next start / next dev, every page) never calls INK itself, it only reads the local snapshot file
# these produce (data/generated/catalog-snapshot.json). Runtime-only; not needed at `next build` time.
INK_API_BASE_URL=https://api.reserva.ink
INK_TOKEN_SUL=
INK_TOKEN_NORTE=
INK_TOKEN_CENTRO=

# Bearer token gating POST /api/admin/catalog-sync. Unset = the route stays disabled (503). Runtime-only,
# on the web service (that route lives in the web app). Generate with e.g. `openssl rand -hex 32`.
ADMIN_SYNC_TOKEN=

# regional (default): each region resolves to its own INK store (Sul->Use Sul, Norte->Use Norte, ...).
# A comma list overrides globally, only when stores are really consolidated: use-origens,use-sul
# Runtime-only.
COMMERCE_STORE_PRIORITY=regional

# Optional. Directory holding the catalog snapshot (catalog-snapshot.json is written/read inside it) — this
# is where a Railway Volume must be mounted. Must be an ABSOLUTE path. Defaults to data/generated under the
# app's working directory if unset; only set this if that default does not match your actual mount path
# (see docs/deploy/railway.md — "do not assume /app"). Runtime-only.
CATALOG_SNAPSHOT_DIR=

# Public site URL for canonical/OG metadata. NEXT_PUBLIC_* is inlined into the client bundle by Next.js at
# `next build` time — this one must be set wherever the BUILD runs, not only where the container starts.
NEXT_PUBLIC_SITE_URL=https://www.useorigens.com.br

# Meta Pixel ID for the /sul storefront only (CLAUDE_USE_ORIGENS_META_PIXEL_INK_ESTADOS.md). NEXT_PUBLIC_* is
# inlined at `next build` time — must be set wherever the BUILD runs, not only where the container starts.
# Unset = MetaPixel renders nothing at all (no <Script>, no request) regardless of consent; the site stays
# fully functional either way. Even when set, the Pixel only ever loads after the visitor accepts the
# consent banner (src/lib/consent) — this variable alone never causes tracking. Numeric digits only
# (validated by validateMetaPixelId() in src/lib/config/env.ts). Production value: 1558923262073052.
NEXT_PUBLIC_META_PIXEL_ID=

# GA4 Measurement ID for the /sul storefront only (CLAUDE_GA4_STOREFRONT_TRACKING.md), same pattern as
# NEXT_PUBLIC_META_PIXEL_ID above: NEXT_PUBLIC_* is inlined at `next build` time — must be set wherever the
# BUILD runs, not only where the container starts. Unset = GoogleAnalytics renders nothing at all (no
# <Script>, no request) regardless of consent; the site stays fully functional either way. Even when set, GA4
# only ever loads after the visitor accepts the consent banner (src/lib/consent) — this variable alone never
# causes tracking. Format G-XXXXXXXXXX (validated by validateGaMeasurementId() in src/lib/config/env.ts).
# Production value: G-8GYTEJ1F77.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ── CMS (admin) — Rodada 7: tudo no Railway ─────────────────────────────────────────────────────────────────
# Todas opcionais. Sem o conjunto OBRIGATÓRIO abaixo (ou com valor inválido, ex.: segredo < 32 caracteres), /admin responde 404 e a loja não muda. Nomes apenas: os valores
# secretos vão direto no painel do Railway (variáveis por referência entre serviços), nunca no Git nem em chat.
# Guia: docs/admin/production-runbook.md. Verificação (só nomes e OK/FAIL): npm run cms:check
#
# Obrigatórias para o admin de produção:
#   ADMIN_HOST=www.useorigens.com.br              (host da loja: o painel vive em /admin no mesmo host; sem https://)
#   ADMIN_OWNER_EMAIL=                            (e-mail do primeiro owner; nunca no repositório)
#   RAILWAY_OAUTH_CLIENT_ID=                      (Login with Railway: Settings → Developer → OAuth App;
#                                                  redirect exato: https://www.useorigens.com.br/admin/auth/callback)
#   RAILWAY_OAUTH_CLIENT_SECRET=
#   ADMIN_SESSION_SECRET=                         (>= 32 caracteres aleatórios: openssl rand -base64 48)
#   DATABASE_URL=                                 (referência ao PostgreSQL do mesmo projeto Railway)
# Opcionais:
#   ADMIN_OWNER_RAILWAY_SUB=                      (id imutável da conta Railway do owner, se o e-mail não vier verificado)
#   DATABASE_SSL=require   DATABASE_POOL_MAX=4
#   Railway Storage Bucket (privado; envio de imagens). Referencie as variáveis do serviço do bucket:
#   BUCKET_ENDPOINT=  BUCKET_NAME=  BUCKET_ACCESS_KEY_ID=  BUCKET_SECRET_ACCESS_KEY=  BUCKET_REGION=auto
#   BUCKET_ADDRESSING=path                        (só se o bucket for antigo e exigir path-style)
#   SITE_CONFIG_HOME=on                           (liga a home configurável; DESLIGADO até a aprovação final)
